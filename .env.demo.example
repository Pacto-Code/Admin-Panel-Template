APP_ENV=demo
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shop
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3000
SESSION_SECRET=change-me-at-least-32-characters-long-xxxxxxxx
# base64 of 32 random bytes, for example: openssl rand -base64 32
ENCRYPTION_KEY=change-me-base64-of-32-random-bytes
EMAIL_FROM=shop@example.com
# Proxies in front of the API: "false" (none), a hop count, or comma-separated IPs / CIDR ranges.
TRUST_PROXY=false
